<div class="cart-drawer-container">
  <div class="cart-drawer">
    <button class="cart-drawer-close" aria-label="Close cart drawer">X</button>

    <div class="cart-drawer-contents">
      {% if cart.item_count > 0 %}
        <ul>
          {% for item in cart.items %}
            <li>
              {% if item.image %}
                {% render 'image', image: item.image, url: item.url, width: 120, height: 120, crop: 'center' %}
              {% endif %}

              <div>
                <h3>{{ item.product.title }}</h3>
                <p>{{ item.variant.title }}</p>
                <p>{{ item.price | money }}</p>
                <p>Qty: {{ item.quantity }}</p>
              </div>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p>Your cart is empty.</p>
      {% endif %}
    </div>
    <div class="cart-drawer-footer">
      <p>Total: {{ cart.total_price | money }}</p>
      <a href="{{ routes.checkout_url }}" class="cart-drawer-checkout">Checkout</a>
    </div>
  </div>
</div>

{% stylesheet %}
  .cart-drawer-container {
    visibility: hidden;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100vw;
    height: 100%;
    display: flex;
    justify-content: flex-end;
    background-color: rgba(0, 0, 0, 0.5);
    transition: visibility 0.3s ease;
  }

  .cart-drawer {
    height: 100%;
    width: 40rem;
    max-width: calc(100vw - 3rem);
    padding: 0 1.5rem;
    border: 0.1rem solid rgba(0, 0, 0, 0.2);
    border-right: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--color-background);
    transform: translate(100%);
    transition: transform 0.3s ease;
  }

  .cart-drawer-container.active {
    visibility: visible;
  }

  .cart-drawer-container.active .cart-drawer {
    transform: translate(0);
  }

  .cart-drawer-close {
    cursor: pointer;
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    // Close cart drawer when clicking outside of it
    document.querySelector('.cart-drawer-container').addEventListener('click', (e) => {
      if (e.target === document.querySelector('.cart-drawer-container')) {
        document.querySelector('.cart-drawer-container').classList.remove('active');
      }
    });

    // Close button
    document.querySelector('.cart-drawer-close').addEventListener('click', () => {
      document.querySelector('.cart-drawer-container').classList.remove('active');
    });

    // Update cart drawer contents asynchronously
    const refreshCartDrawer = async () => {
      try {
        const response = await fetch('/?sections=cart-drawer');
        if (!response.ok) throw new Error('Unable to refresh cart drawer.');

        const data = await response.json();
        const sectionHtml = data['cart-drawer'];

        const parser = new DOMParser();
        const parsedHtml = parser.parseFromString(sectionHtml, 'text/html');
        const innerDrawer = parsedHtml.querySelector('.cart-drawer-contents');
        const updateTarget = document.querySelector('.cart-drawer-contents');

        if (innerDrawer && updateTarget) {
          updateTarget.innerHTML = innerDrawer.innerHTML;
        }
      } catch (error) {
        console.error(error);
      }
    };

    // Update cart count asynchronously
    const refreshCartCounts = async () => {
      try {
        const response = await fetch('/cart.js');
        if (!response.ok) throw new Error('Unable to refresh cart count.');

        const cart = await response.json();

        const updateTargets = document.querySelectorAll('.cart-item-count');

        updateTargets.forEach((target) => {
          target.textContent = cart.item_count;
        });
      } catch (error) {
        console.error(error);
      }
    };

    // Ajax add to cart
    const productForm = document.querySelector('.product-form form');

    if (productForm) {
      productForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const submitButton = productForm.querySelector('.submit');
        const originalButtonText = submitButton.value;

        if (submitButton) {
          submitButton.disabled = true;
          submitButton.value = 'Adding...';
        }

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            body: new FormData(productForm),
          });

          if (!response.ok) {
            throw new Error('Unable to add item to cart.');
          }

          const activeDrawer = document.querySelector('.cart-drawer-container');

          if (activeDrawer) {
            activeDrawer.classList.add('active');
          }

          if (submitButton) {
            submitButton.value = originalButtonText;
            submitButton.disabled = false;
          }

          refreshCartDrawer();
          refreshCartCounts();
        } catch (error) {
          console.error(error);

          if (submitButton) {
            submitButton.disabled = false;
            submitButton.value = originalButtonText;
          }

          alert('There was a problem adding this item to the cart. Please try again.');
        }
      });
    }

    // Toggle cart drawer on cart icon click
    const cartToggle = document.querySelector('.cart-toggle');

    if (cartToggle) {
      cartToggle.addEventListener('click', (e) => {
        e.preventDefault();
        const drawer = document.querySelector('.cart-drawer-container');

        if (drawer) {
          drawer.classList.toggle('active');
        }
      });
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "t.general.cart_drawer",
  "settings": []
}
{% endschema %}
