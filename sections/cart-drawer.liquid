<div class="cart-drawer-container">
  <div class="cart-drawer">
    <div class="cart-drawer-header">
      <h2>Your Cart</h2>
      <button class="cart-drawer-close btn-reset" aria-label="Close cart drawer">
        {{ 'icon-close.svg' | inline_asset_content }}
      </button>
    </div>

    <div class="cart-drawer-contents">
      {% if cart.item_count > 0 %}
        <ul class="cart-drawer-items list-reset">
          {% for item in cart.items %}
            <li class="cart-drawer-item">
              {% if item.image %}
                {% render 'image', image: item.image, url: item.url, width: 240, height: 240, crop: 'center' %}
              {% endif %}

              <div>
                <h3>{{ item.product.title }}</h3>
                <p>{{ item.price | money }}</p>
                <div class="cart-drawer-item-options">
                  {%- for option in item.options_with_values -%}
                    <dl class="cart-drawer-item-option">
                      <dt>{{ option.name }}:</dt>
                      <dd>{{ option.value }}</dd>
                    </dl>
                  {%- endfor -%}
                </div>
                <p>Qty: {{ item.quantity }}</p>
                <button class="cart-drawer-item-remove btn-reset" aria-label="Remove item">
                  {{ 'icon-trash.svg' | inline_asset_content }}
                </button>
              </div>
              <div>
                {{ item.line_price | money }}
              </div>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p>Your cart is empty.</p>
      {% endif %}
    </div>
    <div class="cart-drawer-footer">
      {% if cart.item_count > 0 %}
        <p>Subtotal: {{ cart.total_price | money }}</p>
        <a href="/checkout" class="cart-drawer-checkout">Checkout</a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .cart-drawer-container {
    visibility: hidden;
    position: fixed;
    z-index: 1000;
    inset: 0;
    display: flex;
    justify-content: flex-end;
    background-color: rgba(0, 0, 0, 0.5);
    transition: visibility 0.3s ease;
  }

  .cart-drawer {
    height: 100%;
    width: 40rem;
    max-width: calc(100vw - 3rem);
    padding: 0 1.5rem;
    border-right: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--color-background);
    transform: translate(100%);
    transition: transform 0.3s ease;
  }

  .cart-drawer-container.active {
    visibility: visible;
  }

  .cart-drawer-container.active .cart-drawer {
    transform: translate(0);
  }

  .cart-drawer-close {
    cursor: pointer;
    width: 3rem;
    height: 3rem;
  }

  .cart-drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0;
    margin-bottom: 1rem;
    border-bottom: 0.1rem solid rgba(0, 0, 0, 0.2);
  }

  .cart-drawer-contents {
    flex: 1;
    overflow-y: auto;
  }

  .cart-drawer-items {
    display: grid;
    gap: 1rem;
  }

  .cart-drawer-item {
    display: grid;
    grid-template-columns: 1fr 2fr auto;
    gap: 1rem;
  }

  .cart-drawer-item-options {
    font-size: 1.2rem;
  }

  .cart-drawer-item-option {
    display: flex;
    gap: 0.2rem;
  }

  .cart-drawer-item-remove {
    width: 3rem;
    height: 3rem;
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    // Close cart drawer when clicking outside of it
    document.querySelector('.cart-drawer-container').addEventListener('click', (e) => {
      if (e.target === document.querySelector('.cart-drawer-container')) {
        document.querySelector('.cart-drawer-container').classList.remove('active');
        document.querySelector('body').classList.remove('overflow-hidden');
      }
    });

    // Close button
    document.querySelector('.cart-drawer-close').addEventListener('click', () => {
      document.querySelector('.cart-drawer-container').classList.remove('active');
      document.querySelector('body').classList.remove('overflow-hidden');
    });

    // Update cart drawer contents asynchronously
    const refreshCartDrawer = async () => {
      try {
        const response = await fetch('/?sections=cart-drawer');
        if (!response.ok) throw new Error('Unable to refresh cart drawer.');

        const data = await response.json();
        const sectionHtml = data['cart-drawer'];

        const parser = new DOMParser();
        const parsedHtml = parser.parseFromString(sectionHtml, 'text/html');
        const cartContents = parsedHtml.querySelector('.cart-drawer-contents');
        const cartContentsTarget = document.querySelector('.cart-drawer-contents');
        const cartFooter = parsedHtml.querySelector('.cart-drawer-footer');
        const cartFooterTarget = document.querySelector('.cart-drawer-footer');

        if (cartContents && cartContentsTarget) {
          cartContentsTarget.innerHTML = cartContents.innerHTML;
        }

        if (cartFooter && cartFooterTarget) {
          cartFooterTarget.innerHTML = cartFooter.innerHTML;
        }
      } catch (error) {
        console.error(error);
      }
    };

    // Update cart count asynchronously
    const refreshCartCounts = async () => {
      try {
        const response = await fetch('/cart.js');
        if (!response.ok) throw new Error('Unable to refresh cart count.');

        const cart = await response.json();

        const updateTargets = document.querySelectorAll('.cart-item-count');

        updateTargets.forEach((target) => {
          target.textContent = cart.item_count;
        });
      } catch (error) {
        console.error(error);
      }
    };

    // Ajax add to cart
    const productForm = document.querySelector('.product-form form');

    if (productForm) {
      productForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const submitButton = productForm.querySelector('.submit');
        const originalButtonText = submitButton.value;

        if (submitButton) {
          submitButton.disabled = true;
          submitButton.value = 'Adding...';
        }

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            body: new FormData(productForm),
          });

          if (!response.ok) {
            throw new Error('Unable to add item to cart.');
          }

          const activeDrawer = document.querySelector('.cart-drawer-container');

          if (activeDrawer) {
            activeDrawer.classList.add('active');
            document.querySelector('body').classList.add('overflow-hidden');
          }

          if (submitButton) {
            submitButton.value = originalButtonText;
            submitButton.disabled = false;
          }

          refreshCartDrawer();
          refreshCartCounts();
        } catch (error) {
          console.error(error);

          if (submitButton) {
            submitButton.disabled = false;
            submitButton.value = originalButtonText;
          }

          alert('There was a problem adding this item to the cart. Please try again.');
        }
      });
    }

    // Toggle cart drawer on cart icon click
    const cartToggle = document.querySelector('.cart-toggle');

    if (cartToggle) {
      cartToggle.addEventListener('click', (e) => {
        e.preventDefault();
        const drawer = document.querySelector('.cart-drawer-container');

        if (drawer) {
          drawer.classList.toggle('active');
          document.querySelector('body').classList.toggle('overflow-hidden');
        }
      });
    }
  });
{% endjavascript %}

