<script defer src="{{ 'swiper-bundle.min.js' | asset_url }}"></script>
{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}

<div class="product-main">
  <div class="product-main-images">
    <div class="product-gallery swiper">
      <div class="swiper-wrapper">
        {% for image in product.images %}
          <div class="swiper-slide">
            {% render 'image', class: 'product-image', image: image %}
          </div>
        {% endfor %}
      </div>
    </div>
    <div class="product-gallery-nav swiper">
      <div class="swiper-wrapper">
        {% for image in product.images %}
          <div class="swiper-slide" data-index="{{ forloop.index0 }}">
            {% render 'image', class: 'product-image', image: image, width: 400, height: 400, crop: 'center' %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
  <div>
    <div class="product-main-info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
          {%- when 'title' -%}
            <h1>{{ product.title }}</h1>
          {%- when 'description' -%}
            <div class="product-description">{{ product.description }}</div>
          {%- when 'price' -%}
            {% render 'price' %}
          {%- when 'form' -%}
            {% render 'product-form', product: product %}
          {%- when 'variant_selector' -%}
            {% render 'variant-selector', product: product %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .product-main {
    display: grid;
    grid-template-columns: repeat(2, 50%);
    gap: 2rem;
  }

  .product-price {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .product-price-compare {
    text-decoration: line-through;
    opacity: 0.6;
  }

  .product-gallery .product-image > img {
    width: auto;
    max-height: 60rem;
    margin: 0 auto;
  }

  .product-gallery-nav {
    margin-top: 1rem;
  }

  .product-gallery-nav .swiper-slide {
    width: 10rem;
    cursor: pointer;
  }
{% endstylesheet %}

<script type="application/json" id="product-data">
  {
    "variants": {{ product.variants | json }},
    "moneyFormat": {{ shop.money_format | json }}
  }
</script>

{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    const gallery = new Swiper('.product-gallery', {
      slidesPerView: 1,
      allowTouchMove: true,
    });

    const galleryNav = new Swiper('.product-gallery-nav', {
      slidesPerView: 'auto',
      spaceBetween: 12,
      watchSlidesProgress: true,
    });

    // Gallery thumbnail navigation
    document.querySelectorAll('.product-gallery-nav .swiper-slide').forEach((slide) => {
      slide.addEventListener('click', function () {
        const index = Number(this.dataset.index);

        if (!Number.isNaN(index)) {
          gallery.slideTo(index);
        }
      });
    });

    // Update price on variant change
    const productDataEl = document.getElementById('product-data');
    const productData = productDataEl ? JSON.parse(productDataEl.textContent) : { variants: [], moneyFormat: '$' };
    const productVariants = productData.variants || [];

    const variantSelect = document.querySelector('.product-form .product-variant-select');
    const priceCurrentEl = document.querySelector('.product-price-current');
    const priceCompareEl = document.querySelector('.product-price-compare');
    const moneyFormat = productData.moneyFormat || '$';

    function updateURLWithVariant(variantId) {
      if (!variantId) return;

      const url = new URL(window.location.href);
      url.searchParams.set('variant', String(variantId));
      window.history.replaceState({}, '', url);
    }

    function formatMoney(cents) {
      if (window.Shopify && typeof Shopify.formatMoney === 'function') {
        return Shopify.formatMoney(cents, moneyFormat);
      }

      return '$' + (cents / 100).toFixed(2);
    }

    function updateProductPrice() {
      if (!variantSelect || !priceCurrentEl) return;

      const selectedVariant = productVariants.find((variant) => Number(variant.id) === Number(variantSelect.value));

      if (!selectedVariant) return;

      priceCurrentEl.textContent = formatMoney(selectedVariant.price);

      if (priceCompareEl) {
        const hasComparePrice = Number(selectedVariant.compare_at_price || 0) > Number(selectedVariant.price || 0);

        priceCompareEl.textContent = hasComparePrice ? formatMoney(selectedVariant.compare_at_price) : '';
        priceCompareEl.hidden = !hasComparePrice;
      }

      updateURLWithVariant(selectedVariant.id);
    }

    if (variantSelect) {
      const initialVariantId = new URLSearchParams(window.location.search).get('variant');

      if (initialVariantId) {
        variantSelect.value = String(initialVariantId);
      }

      variantSelect.addEventListener('change', updateProductPrice);
    }

    // Update variant based on selected options
    function updateVariantFromOptions() {
      const selectedOptions = Array.from(document.querySelectorAll('.product-option-select')).map(
        (select) => select.value
      );

      const matchingVariant = productVariants.find((variant) => {
        return (
          variant.options &&
          variant.options.length === selectedOptions.length &&
          variant.options.every((option, index) => option === selectedOptions[index])
        );
      });

      if (!matchingVariant) return;

      variantSelect.value = String(matchingVariant.id);
      updateURLWithVariant(matchingVariant.id);
      updateProductPrice();
    }

    document.querySelectorAll('.product-option-select').forEach((select) => {
      select.addEventListener('change', updateVariantFromOptions);
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "form",
      "name": "Product Form",
      "limit": 1
    },
    {
      "type": "variant_selector",
      "name": "Variant Selector",
      "limit": 1
    }
  ]
}
{% endschema %}
