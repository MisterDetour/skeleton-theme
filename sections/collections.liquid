<main class="collections-main">
  <h1>{{ 'collections.title' | t }}</h1>

  <div
    class="collections"
  >
    {% for collection in collections %}
      <a class="collection-card link-reset" href="{{ collection.url }}">
        {% if collection.featured_image %}
          {% render 'image',
            class: 'collection-card-image',
            image: collection.featured_image,
            width: 600,
            height: 600,
            crop: 'center'
          %}
        {% endif %}

        <div class="collection-card-content">
          <h2>{{ collection.title }}</h2>

          {% if collection.description %}
            <p>{{ collection.description | strip_html | truncatewords: 15 }}</p>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</main>

{% stylesheet %}
  .collections {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }

  .collection-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
